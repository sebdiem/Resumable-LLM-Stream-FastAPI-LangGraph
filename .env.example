# LangGraph checkpointer (Postgres).
# With docker-compose the DB service is reachable as host "db".
# For local runs (no docker), use e.g. postgres://user:pass@localhost:5432/chat.
DATABASE_URI=postgres://chat:chat@db:5432/chat

# Redis. With docker-compose the service is "redis".
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# LLM provider keys — only the one selected in src/ai/config.py is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Web search tool
TAVILY_API_KEY=
